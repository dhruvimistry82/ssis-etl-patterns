          SQLTask:SqlStatementSource="INSERT INTO SSISPackageLog&#xA;                  (PackageName, StartTime, EndTime, DurationInSeconds)&#xA;VALUES (?,?, GETDATE(), DATEDIFF([SECOND],?, GETDATE()))" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
